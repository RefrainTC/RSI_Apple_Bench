# Teacher-forced re-read by the parent (TF_DIRS set by harness/run.sh): one request of ~2.3k prompt tokens per call; the
# fp32 log-softmax over all prompt positions needs ~1.5 GB next to the KV pool, hence the smaller pool.
. "$ISO_ROOT/loads/cal.env"
export TF=1 MEMU=0.50   # 0.60 until 2026-11-25: the subpatch re-read peaked 45 MiB under the 97 % watchdog (acc6)
