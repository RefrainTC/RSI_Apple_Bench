# Official load of the #37338 task (batch 4's env/C19_cal.env with 3 steady reps): Qwen3.5-4B, vLLM V1 offline,
# max_model_len 4096, max_num_seqs 16, gpu_memory_utilization 0.85. Every run is a cold start (empty compile caches, set
# by harness/run.sh). The first generate() after LLM() returns is 8 prompts x 512 random ids -> 8 greedy tokens; then 3
# steady reps of the same shape. Score: cold time to first result (process launch -> first generate() returned).
export M=Qwen/Qwen3.5-4B N=8 IN=512 OL=8 REPS=3 MEMU=0.85
export LLM_KW='{"max_model_len": 4096, "max_num_seqs": 16}'
export TRANSFERS="short long warm"
