# Transfer load: at most 64 running requests (and CUDA graphs up to 64) instead of 256: 4x more admission waves of a
# quarter of the size.
. "$ISO_ROOT/loads/cal.env"
export SGL_KW='{"attention_backend": "triton", "sampling_backend": "pytorch", "max_running_requests": 64, "cuda_graph_max_bs": 64, "disable_radix_cache": true}'
