# Correctness pass of the #17005 task: 24 fixed text prompts, one per call, 256 greedy tokens each (6 tokenizer-manager
# messages per request, so the cached logprob lists are extended 5 times), produced-token logprobs and top-5 logprobs
# compared bit for bit (see bench/sgl_c5y.py CORRECT=1).
. "$ISO_ROOT/loads/cal.env"
export CORRECT=1 COR_OL=256
