# Transfer load = the screen's first load (w1, the load of the prior): 32 requests with 448 x 448 images in ONE
# generate() call, 16 tokens, 3 reps. The screen found no gain here (request hand-over bounds the rep).
. "$ISO_ROOT/loads/cal.env"
export IMG=448 N=32 SEQ=0 OL=16 REPS=3
export LLM_KW='{"max_model_len": 4096, "max_num_seqs": 32, "limit_mm_per_prompt": {"image": 1}, "mm_processor_kwargs": {"min_pixels": 200704, "max_pixels": 200704}, "mm_encoder_attn_backend": "TORCH_SDPA"}'
