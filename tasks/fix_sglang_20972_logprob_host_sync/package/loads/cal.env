# Official load of the #20972 task (same as batch 4's env/C53.env): 8 requests of 128 random token ids -> 512 greedy tokens,
# every request return_logprob=True with top_logprobs_num=5; 5 reps, fresh prompts per rep; metric = median rep.
# Triton attention, pytorch sampling, overlap scheduler on (default), decode CUDA graphs up to batch 16.
export M=Qwen/Qwen2.5-1.5B-Instruct N=8 IN=128 OL=512 REPS=5 MEMF=0.80 LOGPROB=5
export SGL_KW='{"attention_backend": "triton", "sampling_backend": "pytorch", "cuda_graph_max_bs": 16}'
export TF_CHECK=0 TRANSFERS="b1 b32 top20 top0"
