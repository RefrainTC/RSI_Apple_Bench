# Diagnostic transfer load: the official load (random token ids) with statistics on, to record how many MTP drafts get
# accepted there (compare tr_text.env).
. "$ISO_ROOT/loads/cal.env"
export SPECSTATS=1
export LLM_KW='{"max_model_len": 4096, "enable_prefix_caching": false, "disable_log_stats": false, "speculative_config": {"method": "qwen3_5_mtp", "num_speculative_tokens": 1}}'
