# Official load of the #9460 task (same as batch 4's env/C47_cal.env, the w2 load): Qwen2-VL-2B-Instruct, 64 requests
# per rep, each one synthetic 224 x 224 image + a fixed chat prompt -> 256 greedy tokens (ignore_eos), 5 reps with fresh
# seeded images per rep; metric = median rep wall time. Triton attention, pytorch sampling, radix cache off, decode CUDA
# graphs up to batch 64.
export M=Qwen/Qwen2-VL-2B-Instruct N=64 OL=256 IMG=224 REPS=5 MEMF=0.80
export SGL_KW='{"attention_backend": "triton", "sampling_backend": "pytorch", "cuda_graph_max_bs": 64, "disable_radix_cache": true}'
export TRANSFERS="b32 text"
