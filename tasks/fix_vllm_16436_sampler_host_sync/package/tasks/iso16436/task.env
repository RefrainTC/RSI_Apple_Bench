# ISO-Bench #16436 (vLLM, "[Core] Speed up decode by remove synchronizing operation in sampler") as a P2 agent task.
TASK=iso16436
VENV=$ISO_ROOT/venvs/16436_parent        # pristine: parent commit f728ab8e (0.8.5.dev117)
FIX_VENV=$ISO_ROOT/venvs/16436_fix       # human fix 299ebb62 (0.8.5.dev118), used only as oracle
PKG=vllm
GPU=${GPU:-0}
# Storage (2026-11-23, after the first NAS-only calibration was voided): venvs, weights, scratch, overlays and compile caches
# on the pod's local NVMe ($P2T, staged by scripts/stage_tmp.sh; same bytes as the NAS venvs above). Every job records
# P2_STORAGE in job_meta.json; summaries flag mixed storage and a score whose storage differs from the calibration's.
P2_STORAGE=tmp-nvme
if [ "$P2_STORAGE" = tmp-nvme ]; then
  VENV=$P2T/venvs/16436_parent; FIX_VENV=$P2T/venvs/16436_fix
  HF_HOME_TASK=$P2T/hf
  export P2_SCRATCH_ROOT=$P2T/scratch P2_OVERLAY_ROOT=$P2T/overlays
  export P2_CACHE_ROOT=${P2_CACHE_ROOT:-$P2T/cache/iso16436/dev} P2_CACHE_MODE=${P2_CACHE_MODE:-dev-warm}   # score/calibrate: job mode
fi
TASK_ENV="VLLM_PORT=${PORT:-47000}"   # package: per-GPU port from env.sh (authors: "", vLLM picks a free port)
WARMUP_WORKLOAD="SEED_BASE=1000"         # warm-up jobs use other random prompts than the timed runs (seed 0)
SCORE_WORKLOAD=""                       # official scoring load = run.sh defaults (rate 1, 100 prompts, random 1000 in / 100 out)
SCORE_PAIRS=${SCORE_PAIRS:-2}
TRANSFER_WORKLOADS="rate4:RATE=4 rateinf:RATE=inf ol400:OL=400"   # hidden from the agent
DEV_ALLOWED_VARS="RATE NP IN OL"
LOCKED="vllm/config.py vllm/engine/arg_utils.py vllm/envs.py vllm/entrypoints/openai/cli_args.py vllm/entrypoints/cli/ vllm/benchmarks/ vllm/transformers_utils/config.py"
JOB_TIMEOUT=1500
CORRECT_MIN_EXACT=0.9      # correctness: min exact fraction per pass (compare.py arg 3)
CORRECT_TIE_NATS=0.5       # correctness: near-tie threshold in nats (compare.py arg 4)
# review fixes (2026-11-23, shared harness): scored-output check, settings check, audit hook, per-run venv guard
OUT_MIN_EXACT=0.9          # scored outputs (outcheck.py): identical texts vs the paired parent; A/A 0.97-1.00, fix 0.95-1.00
SETTINGS_IGNORE="kv_cache_tokens"
AUDIT=1; P2_AUDIT_NEED_END=0   # the server is stopped with SIGINT/KILL, so no end record is required
# benign library behaviour seen on every trusted run (2026-11-23): ray's pyamdsmi probe and platform.architecture()
# package: the staged interpreter path is $P2T/uvpy/... (regex-escaped below)
_P2T_RE=$(printf '%s' "$P2T" | sed 's/[][\\.^$*+?(){}|]/\\&/g')
P2_AUDIT_IGNORE='^\{"kind": "exec", "pid": [0-9]+, "exe": "(sh|file)", "argv": \[("/bin/sh", "-c", "cat /sys/module/amdgpu/initstate \|grep live"|"file", "-b", "'"$_P2T_RE"'/uvpy/cpython-3\.10\.20-linux-x86_64-gnu/bin/python3\.10")\]\}$'
P2_FRESH_VENV=1
GATE_PROTECT='compilation_config|CompilationConfig|cudagraph|cuda_graph|CUDAGraph|capture_model|enforce_eager|torch\.compile'   # engine settings that must keep their effect (gate: added AND removed lines)
