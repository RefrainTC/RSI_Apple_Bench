# Official load of the #30056 task (= batch 6's env/N1.env): Qwen3-0.6B with the qwen3 reasoning parser. 64 requests x
# 1024 random token ids -> 512 greedy tokens (ignore_eos) in one generate() call, 3 reps with fresh prompts per rep;
# metric = median rep wall time. Every request has a small JSON schema as structured output, and logit_bias -100 on
# <think> (151667) and </think> (151668): reasoning never ends, so the engine checks on every step whether it has.
export M=Qwen/Qwen3-0.6B N=64 IN=1024 OL=512 REPS=3 MEMU=0.80
export LLM_KW='{"max_model_len": 2048, "max_num_seqs": 64, "enable_prefix_caching": false, "reasoning_parser": "qwen3"}'
export SP_KW='{"logit_bias": {"151667": -100, "151668": -100}, "json_schema": {"type": "object", "properties": {"answer": {"type": "string"}}, "required": ["answer"]}}'
export TRANSFERS="b8 nogrammar"
