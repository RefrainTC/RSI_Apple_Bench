# Transfer load: natural-language requests instead of random token ids, so that MTP drafts get accepted and the code path
# the PR changes (accepted counts > 1) runs on every step. 1 essay request per rep (topic picked by the rep's seed), 512
# greedy tokens (ignore_eos), 3 reps. Statistics on (disable_log_stats false, the same in both arms) to record the
# speculative-decoding counters.
. "$ISO_ROOT/loads/cal.env"
export PTYPE=text SPECSTATS=1
export LLM_KW='{"max_model_len": 4096, "enable_prefix_caching": false, "disable_log_stats": false, "speculative_config": {"method": "qwen3_5_mtp", "num_speculative_tokens": 1}}'
