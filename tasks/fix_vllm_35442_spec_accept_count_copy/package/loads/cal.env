# Official load of the #35442 task (the batch-5 screen's batch-1 transfer load, env C15_n1.env): Qwen3.5-4B, vLLM V1
# offline, MTP speculative decoding with 1 token, prefix caching off, max_model_len 4096, gpu_memory_utilization 0.80.
# 1 request of 256 random token ids -> 512 greedy tokens (ignore_eos) per rep, 3 reps with fresh prompts per rep; metric
# = median rep wall time.
export M=Qwen/Qwen3.5-4B N=1 IN=256 OL=512 REPS=3 MEMU=0.80
export LLM_KW='{"max_model_len": 4096, "enable_prefix_caching": false, "speculative_config": {"method": "qwen3_5_mtp", "num_speculative_tokens": 1}}'
export TRANSFERS="b4 b16 text"
