# Official load of the #27868 task (batch 4's env/C56_cal.env): Qwen3.5-4B, 4 requests x 256 random token ids -> 512
# greedy tokens (ignore_eos), 3 reps with fresh prompts per rep; metric = median rep wall time. Triton attention, pytorch
# sampling, decode CUDA graphs up to batch 8 (this SGLang calls the option cuda_graph_max_bs_decode).
export M=Qwen/Qwen3.5-4B N=4 IN=256 OL=512 REPS=3 MEMF=0.80
export SGL_KW='{"attention_backend": "triton", "sampling_backend": "pytorch", "cuda_graph_max_bs_decode": 8}'
export TRANSFERS="b1 b8"
