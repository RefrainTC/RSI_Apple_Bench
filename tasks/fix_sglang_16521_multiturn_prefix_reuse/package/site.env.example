# site.env : copy to site.env (next to env.sh) and edit. Plain shell assignments; read by env.sh. Values the caller
# already set in the environment win over these.
STAGE=/tmp/c5x/st           # fast local disk; needs ~30 GB
GPU=0                       # GPU index for calibration and scoring
CPUS=0-7,32-39              # taskset list near that GPU (authors: one CCD + SMT siblings); omit = all CPUs
PORT=33000                  # distinct per GPU if you run several jobs at once
# UV=$HOME/.local/bin/uv
