# Official load of the #16521 task (same as batch 4's env/C52.env): 64 two-turn conversations per rep, turn 1 = 256 random
# token ids -> 256 greedy tokens, turn 2 = turn-1 ids + turn-1 output + 32 new ids -> 8 tokens; 4 reps, fresh prompts per
# rep; metric = median turn-2 wall time. Triton attention, pytorch sampling, decode CUDA graphs up to batch 64.
export M=Qwen/Qwen2.5-1.5B-Instruct N=64 IN=256 OL=256 MT=1 NEW=32 OL2=8 REPS=4 MEMF=0.80
export SGL_KW='{"attention_backend": "triton", "sampling_backend": "pytorch", "cuda_graph_max_bs": 64}'
export TF_CHECK=1 TRANSFERS="ol64 ol1024 pg16"
