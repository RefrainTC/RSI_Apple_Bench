# Official load of the #27418 task (the batch-5 screen's second load w2, env C77w2.env): Qwen2-VL-2B-Instruct, vLLM V1
# offline, max_model_len 4096, max_num_seqs 32, one image per prompt at exactly 1344 x 1344 (min_pixels = max_pixels =
# 1,806,336: 9,216 patches, 2,304 image tokens), vision attention TORCH_SDPA (on sm_89 this vLLM would pick xFormers,
# which is not installed), gpu_memory_utilization 0.80. Per rep 4 requests, each in its own generate() call, each one
# synthetic image + "Describe this image in detail.", 8 greedy tokens (ignore_eos); 5 reps; metric = median rep.
export M=Qwen/Qwen2-VL-2B-Instruct IMG=1344 N=4 SEQ=1 OL=8 REPS=5 MEMU=0.80
export LLM_KW='{"max_model_len": 4096, "max_num_seqs": 32, "limit_mm_per_prompt": {"image": 1}, "mm_processor_kwargs": {"min_pixels": 1806336, "max_pixels": 1806336}, "mm_encoder_attn_backend": "TORCH_SDPA"}'
export TRANSFERS="i448 w1"
