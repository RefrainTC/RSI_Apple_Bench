# Official load of the #14956 task (the batch-5 screen's env/C48.env): Qwen2-VL-2B-Instruct, text-only requests:
# 64 requests x 128 random token ids -> 256 greedy tokens (ignore_eos) in one generate() call, 5 reps with fresh prompts
# per rep; metric = median rep wall time. Triton attention, pytorch sampling, decode CUDA graphs up to batch 64, radix
# cache off. SGLANG_DISABLE_CUDNN_CHECK=1 (harness/run.sh): this SGLang refuses to start on torch 2.9.1 with cuDNN 9.10
# because of a Conv3d bug (pytorch#168167); the load has no images, so the vision tower never runs.
export M=Qwen/Qwen2-VL-2B-Instruct N=64 IN=128 OL=256 REPS=5 MEMF=0.80
export SGL_KW='{"attention_backend": "triton", "sampling_backend": "pytorch", "cuda_graph_max_bs": 64, "disable_radix_cache": true}'
export TRANSFERS="b8 img"
