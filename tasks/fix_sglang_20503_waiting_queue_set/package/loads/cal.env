# Official load of the #20503 task (the batch-6 screen's env/N2.env): Qwen2.5-0.5B-Instruct, one generate() call with
# 16,384 requests x 32 random token ids -> 16 greedy tokens (ignore_eos), 3 reps with fresh prompts per rep; metric =
# median rep wall time. At most 256 running requests, so the scheduler admits ~64 waves of 256 from a waiting queue that
# starts near 16k; the parent's queue update costs O(waiting x admitted) Python per admission. Triton attention, pytorch
# sampling, decode CUDA graphs up to batch 256, radix cache off. SGLANG_DISABLE_CUDNN_CHECK=1 (harness/run.sh): this
# SGLang refuses to start on torch 2.9.1 with cuDNN 9.10 because of a Conv3d bug (pytorch#168167); the model has no conv.
export M=Qwen/Qwen2.5-0.5B-Instruct N=16384 IN=32 OL=16 REPS=3 MEMF=0.80
export SGL_KW='{"attention_backend": "triton", "sampling_backend": "pytorch", "max_running_requests": 256, "cuda_graph_max_bs": 256, "disable_radix_cache": true}'
export TRANSFERS="n4k r64"
