# Official load of the #17005 task (the batch-7 screen's env/M2.env): Qwen2.5-0.5B-Instruct, one generate() call with
# 192 requests x 64 random token ids -> 2048 greedy tokens (ignore_eos), every request with return_logprob and the top
# 20 logprobs per position, no streaming; 3 reps with fresh prompts per rep; metric = median rep wall time. The
# scheduler sends each request's new tokens to the tokenizer manager every 50 tokens; there the parent converts all of
# the request's logprob positions to Python lists again on every message. Triton attention, pytorch sampling, radix cache
# off, at most 256 running requests. SGLANG_DISABLE_CUDNN_CHECK=1 is set by harness/run.sh (no effect on this model).
export M=Qwen/Qwen2.5-0.5B-Instruct N=192 IN=64 OL=2048 REPS=3 MEMF=0.80 LOGPROB=20
export SGL_KW='{"attention_backend": "triton", "sampling_backend": "pytorch", "max_running_requests": 256, "disable_radix_cache": true}'
export TRANSFERS="k5 nolp"
