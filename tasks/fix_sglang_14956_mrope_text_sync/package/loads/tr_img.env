# Transfer load (negative control, as in the screen's env/C48_tr_img.env): every request carries one synthetic 224 x 224
# image + a short text (64 requests, 256 tokens). Image requests take the other decode branch, where the parent has no
# device-to-host read, so no gain is expected. Outputs of this load vary run to run inside each arm (arrival grouping).
. "$ISO_ROOT/loads/cal.env"
export IMG=224
