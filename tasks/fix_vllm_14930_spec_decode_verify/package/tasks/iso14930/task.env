# ISO-Bench #14930 (vLLM, "[V1][Spec Decode] Optimize Rejection Sampler with Triton Kernels") as a P2 task, 2026-11-24.
# Parent 3a1e6481 (0.8.0rc3.dev21), fix 99abb8b6. Harness: harness_iso14930/ (per-PR copy of harness/; changes listed
# in harness_iso14930/CHANGES_iso14930.txt). Official load: runner.py defaults (64 x 1024-token "lure" repeated-segment prompts from a curated pool,
# 256 out, greedy, n-gram k=3, primed prefix cache, median of 7 timed reps).
TASK=iso14930
PKG=vllm
GPU=${GPU:-2}
P2_STORAGE=tmp-nvme
VENV=$P2T/venvs/14930_parent      # parent (staged copy of p2-port/venvs/14930_parent; xgrammar==0.1.17 override)
FIX_VENV=$P2T/venvs/14930_fix     # human fix, oracle only
HF_HOME_TASK=$P2T/hf
export P2_SCRATCH_ROOT=$P2T/scratch P2_OVERLAY_ROOT=$P2T/overlays
export P2_CACHE_ROOT=${P2_CACHE_ROOT:-$P2T/cache/iso14930/dev} P2_CACHE_MODE=${P2_CACHE_MODE:-dev-warm}   # score/calibrate: job mode
P2_FRESH_VENV=1
TASK_ENV="VLLM_PORT=${PORT:-47000}"   # package: per-GPU port from env.sh (authors: "", vLLM picks a free port)
SCORE_WORKLOAD=""                   # official load = runner.py defaults
WARMUP_WORKLOAD="SEED_BASE=1000"    # warm-up jobs use other prompts than the timed runs
SCORE_PAIRS=${SCORE_PAIRS:-3}
TRANSFER_WORKLOADS="k5:K=5 t1:TEMP=1.0 n16:N=16 noprime:PRIME=0"   # hidden from the agent
DEV_ALLOWED_VARS="N OL"
# the drafter, engine config, engine core loop and offline entry point are not the task (the trusted driver wraps the
# engine-core client to count tokens per step)
LOCKED="vllm/config.py vllm/engine/arg_utils.py vllm/envs.py vllm/entrypoints/llm.py vllm/v1/engine/ vllm/v1/spec_decode/ngram_proposer.py"
GATE_PROTECT='compilation_config|CompilationConfig|cudagraph|cuda_graph|CUDAGraph|capture_model|enforce_eager|num_speculative_tokens|ngram_prompt_lookup'
JOB_TIMEOUT=900
CORRECT_MIN_EXACT=0.85     # correctness: greedy exact fraction vs the parent (benign batch-composition near-tie flips: up to 5/48 seen in smoke 1)
CORRECT_TIE_NATS=0.15      # compare.py arg 4 = here the sampled-statistics tolerance (relative; lure group 1.6x), not nats. Fix vs parent seen: all +1.5 %, +5.1 %; lure -9.1 %, +3.8 % (different random streams, heavy per-request clustering)
OUTREF=1
SETTINGS_IGNORE="worker.num_gpu_blocks"
AUDIT=1; P2_AUDIT_NEED_END=1
# package: the staged interpreter path is $P2T/uvpy/... (regex-escaped below)
_P2T_RE=$(printf '%s' "$P2T" | sed 's/[][\\.^$*+?(){}|]/\\&/g')
P2_AUDIT_IGNORE='^\{"kind": "exec", "pid": [0-9]+, "exe": "(sh|file)", "argv": \[("/bin/sh", "-c", "cat /sys/module/amdgpu/initstate \|grep live"|"file", "-b", "'"$_P2T_RE"'/uvpy/cpython-3\.10\.20-linux-x86_64-gnu/bin/python3\.10")\]\}$'
