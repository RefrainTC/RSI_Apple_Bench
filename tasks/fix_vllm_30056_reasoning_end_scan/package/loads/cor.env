# Correctness pass of the #30056 task (see bench/offline_c5y.py CORRECT=1): 24 natural questions in Qwen3's chat format
# with thinking on, each with a JSON schema as structured output and no logit_bias, one request per call, 384 greedy
# tokens. The model thinks, writes </think>, and from then on the grammar must constrain the answer: this exercises the
# end-of-reasoning check that the PR changes.
. "$ISO_ROOT/loads/cal.env"
export CORRECT=1
