# ISO-Bench #12380 (vLLM, "[perf] fix perf regression from #12253"), parent 0e74d797 (0.6.6.post2.dev364), fix 6dd94dbe.
# P2 task built 2026-11-24 on the iso12380 harness copy (harness_iso12380/: per-PR locks, host-aware CPU table, STOP file,
# all-rep output calibration). Load = upstream benchmark_latency shape (batch 8, 32 in / 128 out), CUDA graphs on.
TASK=iso12380
PKG=vllm
GPU=${GPU:-0}
P2_STORAGE=tmp-nvme
VENV=$P2T/venvs/12380_parent      # parent 0e74d797, staged copy of p2-port/venvs/12380_parent
FIX_VENV=$P2T/venvs/12380_fix     # human fix 6dd94dbe, oracle only
HF_HOME_TASK=$P2T/hf
export P2_SCRATCH_ROOT=$P2T/scratch P2_OVERLAY_ROOT=$P2T/overlays
export P2_CACHE_ROOT=${P2_CACHE_ROOT:-$P2T/cache/iso12380/dev} P2_CACHE_MODE=${P2_CACHE_MODE:-dev-warm}   # score/calibrate: job mode
P2_FRESH_VENV=1
TASK_ENV="VLLM_PORT=${PORT:-47000}"   # package: per-GPU port from env.sh (authors: "", vLLM picks a free port)
SCORE_WORKLOAD=""                  # official load = run.sh defaults (BS=8 IN=32 OL=128 REPS=10 WARM=3 SEED_BASE=0)
WARMUP_WORKLOAD="SEED_BASE=1000"   # harness warm-up jobs use other prompt sets than the timed runs
SCORE_PAIRS=${SCORE_PAIRS:-3}
TRANSFER_WORKLOADS="bs1:BS=1 bs32:BS=32 ol512:OL=512"   # hidden from the agent
DEV_ALLOWED_VARS="BS IN OL REPS"
LOCKED="vllm/config.py vllm/engine/arg_utils.py vllm/envs.py vllm/entrypoints/llm.py"
# added AND removed lines: graph eligibility limits and capture, eager switch, compile, multi-step, chunked prefill.
# NOT protected: decode_only / use_cuda_graph logic itself (that is what the task is about).
GATE_PROTECT='enforce_eager|capture_model|max_seq_len_to_capture|max_batchsize_to_capture|_BATCH_SIZES_TO_CAPTURE|cudagraph_capture_sizes|torch\.compile|num_scheduler_steps|chunked_prefill'
JOB_TIMEOUT=900
CORRECT_MIN_EXACT=0.75     # correctness (compare.py): min exact fraction (fixed before smoke; see README)
CORRECT_TIE_NATS=0.5       # correctness: near-tie threshold in nats (both sides)
OUTREF=1                   # calibration records the scored-output reference (out_ref.json, out_ref_lp.json)
# scored outputs (outcheck.py): thresholds calibrated on benign variation by harness_iso12380/calib_outputs.py and stored in
# calib.json outcheck_thresholds. Do not set OUT_* here (env wins).
SETTINGS_IGNORE="num_gpu_blocks"   # memory headroom may legitimately change with the candidate's footprint
AUDIT=1; P2_AUDIT_NEED_END=1       # offline driver: the main process must write its audit end record
# package: the staged interpreter path is $P2T/uvpy/... (regex-escaped below)
_P2T_RE=$(printf '%s' "$P2T" | sed 's/[][\\.^$*+?(){}|]/\\&/g')
P2_AUDIT_IGNORE='^\{"kind": "exec", "pid": [0-9]+, "exe": "(sh|file)", "argv": \[("/bin/sh", "-c", "cat /sys/module/amdgpu/initstate \|grep live"|"file", "-b", "'"$_P2T_RE"'/uvpy/cpython-3\.10\.20-linux-x86_64-gnu/bin/python3\.10")\]\}$'
