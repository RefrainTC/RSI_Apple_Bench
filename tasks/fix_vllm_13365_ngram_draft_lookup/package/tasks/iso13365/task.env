# ISO-Bench #13365 (vLLM, "[V1][Spec Decode] Optimize N-gram matching with Numba") as a P2 task. Written 2026-11-24
# for the iso13365 sample card. Harness: harness_iso13365/ (a copy of harness/; changes listed in its CHANGES_iso13365.md).
TASK=iso13365
PKG=vllm
GPU=${GPU:-1}
# host: main pod GPU1 = CCD1 (pinning table); n1 pod GPU1 = CCD3 (quietest CCD on 11-24 07:55 UTC; CCD0 is the
# iso12380 job's, the host's other user was seen on CCD1/CCD2). Local NVMe root: main $P2T (shared, staged), n1 /tmp/ag13365.
# package: P2T (your STAGE) and the CPU list (CPUS -> P2_CPUS_OVERRIDE) come from env.sh. The authors switched here by
# host name: main pod P2T=/tmp/p2 with its pinning table; n1 pod P2T=/tmp/ag13365, P2_CPUS_OVERRIDE=24-31,56-63.
P2_STORAGE=tmp-nvme
VENV=$P2T/venvs/13365_base      # parent c8d70e24 (0.7.3.dev215) + numba 0.60.0 / llvmlite 0.43.0 (the fix's own pins)
FIX_VENV=$P2T/venvs/13365_fix   # human fix 4c822298, oracle only
HF_HOME_TASK=$P2T/hf
export P2_SCRATCH_ROOT=$P2T/scratch P2_OVERLAY_ROOT=$P2T/overlays
export P2_CACHE_ROOT=${P2_CACHE_ROOT:-$P2T/cache/iso13365/dev} P2_CACHE_MODE=${P2_CACHE_MODE:-dev-warm}
P2_FRESH_VENV=1
TASK_ENV="VLLM_PORT=${PORT:-47000}"   # package: per-GPU port from env.sh (authors: "", vLLM picks a free port)
SCORE_WORKLOAD=""                  # official load = run.sh defaults (N=32 IN=2048 OL=128 KIND=repeat REPS=6 SEED_BASE=0)
WARMUP_WORKLOAD="SEED_BASE=500"    # warm-up jobs use other prompts than the timed runs
SCORE_PAIRS=${SCORE_PAIRS:-3}
TRANSFER_WORKLOADS="random:KIND=random late:KIND=late long:IN=3968 b64:N=64"   # hidden from the agent
DEV_ALLOWED_VARS="N IN OL KIND REPS"
LOCKED="vllm/config.py vllm/engine/arg_utils.py vllm/envs.py vllm/entrypoints/ vllm/v1/engine/ vllm/v1/core/ vllm/v1/outputs.py vllm/v1/request.py vllm/sampling_params.py vllm/utils.py"
GATE_PROTECT='CUDAGraph|cudagraph|cuda_graph|capture_model|torch\.compile|compilation_config|enforce_eager'   # added AND removed lines
JOB_TIMEOUT=900
CORRECT_MIN_EXACT=1.0      # unused by compare.py (exact), required by the harness
CORRECT_TIE_NATS=0
OUTREF=1                   # calibration records the scored-output reference (out_ref.json; out_ref_lp.json = a second parent run)
SETTINGS_IGNORE=""
AUDIT=1; P2_AUDIT_NEED_END=1
# benign on every trusted run: ray's amdsmi probe, platform.architecture()'s `file`, and Triton's ptxas when Inductor compiles
# its own generated kernels with a cold cache (correctness runs come before the warm-up jobs)
# package: the staged interpreter path is $P2T/uvpy/... (regex-escaped below)
_P2T_RE=$(printf '%s' "$P2T" | sed 's/[][\\.^$*+?(){}|]/\\&/g')
P2_AUDIT_IGNORE='^\{"kind": "exec", "pid": [0-9]+, "exe": "(sh|file)", "argv": \[("/bin/sh", "-c", "cat /sys/module/amdgpu/initstate \|grep live"|"file", "-b", "[^"]*/uvpy/cpython-3\.10\.20-linux-x86_64-gnu/bin/python3\.10"|"/bin/sh", "-c", "[^"]*/site-packages/triton/backends/nvidia/bin/ptxas -lineinfo -v --gpu-name=sm_89 [^"]*")\]\}$'
