# ISO-Bench #7822 (vLLM, "[Performance][BlockManagerV2] Mark prefix cache block as computed after schedule") as a P2 agent task.
# v2 (2026-11-23, after the independent review raw/V-7822-review/REVIEW.md): official load = shared 645-token prefix +
# 100 distinct questions (F3), scored outputs checked (F2), out-of-process timing witness (F1), gate rules + audit hook +
# per-run venv guard + off-pod manifests (F4), effective settings asserted (F5), tags namespaced (F6), CPU pinning by
# CCD (F8), parent sentinel (F9). Storage: local NVMe. Recalibrated once under all of these.
TASK=iso7822
PKG=vllm
GPU=${GPU:-1}
P2_STORAGE=tmp-nvme
VENV=$P2T/venvs/7822_parent      # parent 029c71de (0.5.5), staged copy of t5-isobench/venvs/7822_parent
FIX_VENV=$P2T/venvs/7822_fix     # human fix 2deb029d, oracle only
HF_HOME_TASK=$P2T/hf
export P2_SCRATCH_ROOT=$P2T/scratch P2_OVERLAY_ROOT=$P2T/overlays
export P2_CACHE_ROOT=${P2_CACHE_ROOT:-$P2T/cache/iso7822/dev} P2_CACHE_MODE=${P2_CACHE_MODE:-dev-warm}   # score/calibrate: job mode
P2_FRESH_VENV=1
TASK_ENV="VLLM_PORT=${PORT:-47000}"   # package: per-GPU port from env.sh (authors: "", vLLM picks a free port)
SCORE_WORKLOAD=""                 # official load = run.sh defaults (WORKLOAD=shared, OL=200, REPEAT=100, SUFFIX_BASE=0)
WARMUP_WORKLOAD="SUFFIX_BASE=1000"   # warm-ups use other questions than the timed runs
SCORE_PAIRS=${SCORE_PAIRS:-3}
TRANSFER_WORKLOADS="ol10:OL=10 rep300:REPEAT=300 ident:WORKLOAD=identical"   # hidden from the agent
DEV_ALLOWED_VARS="OL REPEAT"
LOCKED="vllm/config.py vllm/engine/arg_utils.py vllm/envs.py vllm/entrypoints/llm.py"
GATE_PROTECT='CUDAGraph|cuda\.graph|capture_model|graph_runners|torch\.compile|enforce_eager'   # added AND removed lines
JOB_TIMEOUT=900
CORRECT_MIN_EXACT=0.75     # correctness (compare.py): min exact fraction per pass
CORRECT_TIE_NATS=0.5       # correctness: near-tie threshold in nats (both sides)
OUTREF=1                   # calibration records the scored-output reference (out_ref.json, out_ref_lp.json)
# scored outputs (outcheck.py): thresholds are calibrated on benign variation (human fix + parent runs of the
# calibration) by harness/calib_outputs.py and stored in calib.json outcheck_thresholds. Do not set OUT_* here (env wins).
SETTINGS_IGNORE="num_gpu_blocks"   # memory headroom may legitimately change with the candidate's footprint
AUDIT=1; P2_AUDIT_NEED_END=1       # offline driver: the main process must write its audit end record
# benign library behaviour seen on every trusted run (smoke 2026-11-23): ray's pyamdsmi probe and platform.architecture()
# package: the staged interpreter path is $P2T/uvpy/... (regex-escaped below)
_P2T_RE=$(printf '%s' "$P2T" | sed 's/[][\\.^$*+?(){}|]/\\&/g')
P2_AUDIT_IGNORE='^\{"kind": "exec", "pid": [0-9]+, "exe": "(sh|file)", "argv": \[("/bin/sh", "-c", "cat /sys/module/amdgpu/initstate \|grep live"|"file", "-b", "'"$_P2T_RE"'/uvpy/cpython-3\.10\.20-linux-x86_64-gnu/bin/python3\.10")\]\}$'
