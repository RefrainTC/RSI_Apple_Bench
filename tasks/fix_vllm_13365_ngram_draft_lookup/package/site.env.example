# site.env : copy to site.env (next to env.sh) and edit. Plain shell assignments; read by env.sh.
STAGE=/tmp/iso13365          # fast local disk; needs ~30 GB
GPU=0                       # GPU index for calibration and scoring
CPUS=0-7,32-39              # taskset list near that GPU (one CCD + SMT siblings on the authors' 5975WX); omit = all CPUs
PORT=47000                  # distinct per GPU if you run several jobs at once
# UV=$HOME/.local/bin/uv
